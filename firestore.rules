rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function email() {
      return request.auth.token.email;
    }

    function member() {
      return verified() && exists(/databases/$(database)/documents/members/$(email()));
    }

    function activeMember() {
      return member()
        && get(/databases/$(database)/documents/members/$(email())).data.get('enabled', true) != false;
    }

    function attendanceAdmin() {
      return activeMember()
        && get(/databases/$(database)/documents/members/$(email())).data.get('role', '') == 'admin';
    }

    function hasMemberGrant(grant) {
      return verified() && memberCanUseGrant(
        get(/databases/$(database)/documents/members/$(email())).data, grant);
    }

    function memberCanUseGrant(data, grant) {
      let grants = data.get('grants', []);
      return data.get('enabled', true) != false
        && (data.get('role', '') == 'admin' || grants is list && grant in grants);
    }

    function openStatus(status) {
      return status in ['Chưa làm', 'Đang làm', 'Vướng'];
    }

    function isoDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }

    function validComment(comment) {
      return comment is map && comment.keys().hasAll(['by', 'at', 'text', 'files'])
        && comment.keys().hasOnly(['by', 'at', 'text', 'files', 'replyTo'])
        && comment.by == email() && isoDate(comment.at)
        && comment.text is string && comment.text.size() <= 1000
        && comment.text.matches('(?s).*[^\\s].*')
        && comment.files == [];
    }

    // The index validates the target on append. Author and time identify it if the assignment message moves.
    function validTaskReply(target, comments) {
      return target is map && target.keys().hasAll(['index', 'by', 'at'])
        && target.keys().hasOnly(['index', 'by', 'at'])
        && target.index is int && target.index >= 0 && target.index < comments.size()
        && target.by is string && target.by.size() > 0 && target.by.size() <= 320
        && target.at is string && target.at.size() > 0 && target.at.size() <= 64
        && comments[target.index].by == target.by && comments[target.index].at == target.at;
    }

    function appendsComment() {
      let before = resource.data.get('comments', []);
      let after = request.resource.data.get('comments', []);
      let count = before.size();
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        && before is list && after is list && after.size() == count + 1
        && (count == 0 || after[0:count] == before) && validComment(after[count])
        && ('replyTo' in after[count] ? validTaskReply(after[count].replyTo, before)
          : resource.data.assigneeEmail == email());
    }

    match /members/{id} {
      function memberFields() {
        return ['name', 'email', 'role', 'enabled', 'grants'];
      }
      function validDisplayName(name) {
        return name is string && name.size() <= 250 && name.matches('(?s).*[^\\s].*');
      }
      function validMemberAccess(data) {
        return data.role in ['admin', 'staff'] && data.enabled is bool
          && data.grants is list && data.grants.size() <= 8
          && data.grants.hasOnly(['taskReview', 'requestReview', 'cashReview', 'cashRecord',
            'projectManage', 'weekPlanRead', 'kpiRead', 'recordManage'])
          && (!(id in [email(), 'dungnlt.ops@gmail.com']) || (data.enabled && data.role == 'admin'));
      }
      allow get: if verified() && email() == id;
      allow read: if attendanceAdmin();
      allow create: if attendanceAdmin() && request.resource.data.keys().hasOnly(memberFields())
        && request.resource.data.email == id && id.size() <= 250 && id.matches('^[^ @/]+@[^ @/]+[.][^ @/]+$')
        && validDisplayName(request.resource.data.name) && validMemberAccess(request.resource.data);
      allow update: if attendanceAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'enabled', 'grants'])
        && validMemberAccess(request.resource.data);
      allow update: if activeMember() && email() == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && validDisplayName(request.resource.data.name);
    }

    // Private contact email, keyed by Firebase Auth UID.
    match /memberProfiles/{uid} {
      function ownsProfile() {
        return activeMember() && request.auth.uid == uid;
      }
      function validContact(data) {
        let address = data.get('contactEmail', '');
        return data.keys().hasOnly(['contactEmail']) && address is string && address.size() <= 254
          && address.matches('^[^\\s@/]+@[^\\s@/]+[.][^\\s@/]+$');
      }
      allow get: if ownsProfile();
      allow create, update: if ownsProfile() && validContact(request.resource.data);
    }

    // memberAvatars/{email} stores one raster image (up to 768 KiB) per active member.
    match /memberAvatars/{id} {
      function validAvatar(data) {
        return data.keys().hasAll(['type', 'image']) && data.keys().hasOnly(['type', 'image'])
          && data.type in ['image/jpeg', 'image/png', 'image/webp']
          && data.image is bytes && data.image.size() > 0 && data.image.size() <= 786432;
      }
      allow get: if activeMember() && id == email();
      allow create, update: if activeMember() && id == email() && validAvatar(request.resource.data);
    }

    function shortText(value) {
      return value is string && value.size() <= 250;
    }

    function validWorkSettings(data) {
      let time = '^([01][0-9]|2[0-3]):[0-5][0-9]$';
      let day = [0, 0.5, 1];
      let overrides = data.get('dayOverrides', {});
      return data.shiftIn.matches(time) && data.shiftOut.matches(time)
        && (data.lunchFrom == '' || data.lunchFrom.matches(time)) && (data.lunchTo == '' || data.lunchTo.matches(time))
        && (data.remindIn == '' || data.remindIn.matches(time)) && (data.remindOut == '' || data.remindOut.matches(time))
        && data.grace is int && data.grace >= 0
        && data.days['0'] in day && data.days['1'] in day && data.days['2'] in day && data.days['3'] in day
        && data.days['4'] in day && data.days['5'] in day && data.days['6'] in day
        && overrides is map && overrides.values().hasOnly(day)
        && data.gpsOn is bool && data.gpsLat is number && data.gpsLat >= -90 && data.gpsLat <= 90
        && data.gpsLng is number && data.gpsLng >= -180 && data.gpsLng <= 180
        && (!data.gpsOn || data.gpsLat != 0 || data.gpsLng != 0)
        && data.gpsRadius is int && data.gpsRadius >= 50
        && data.emailOn is bool && data.autoStart is bool && data.requireReview is bool
        && data.requireReportNote is bool && data.updatedBy == email() && isoDate(data.updatedAt);
    }

    match /settings/work {
      function fields() {
        return ['shiftIn', 'shiftOut', 'lunchFrom', 'lunchTo', 'remindIn', 'remindOut', 'grace', 'days', 'dayOverrides',
          'gpsOn', 'gpsLat', 'gpsLng', 'gpsRadius', 'emailOn', 'autoStart', 'requireReview', 'requireReportNote', 'updatedBy', 'updatedAt'];
      }
      allow get: if activeMember();
      allow create: if attendanceAdmin() && request.resource.data.keys().hasOnly(fields())
        && validWorkSettings(request.resource.data);
      allow update: if attendanceAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields())
        && validWorkSettings(request.resource.data);
    }

    match /settings/budget {
      function fields() {
        return ['Chi phí cố định', 'Chi phí nhân sự', 'Chi phí hoạt động', 'Thuế, phí nhà nước', 'Tài chính & khác'];
      }
      function validBudget(data) {
        return data['Chi phí cố định'] is int && data['Chi phí cố định'] >= 0
          && data['Chi phí nhân sự'] is int && data['Chi phí nhân sự'] >= 0
          && data['Chi phí hoạt động'] is int && data['Chi phí hoạt động'] >= 0
          && data['Thuế, phí nhà nước'] is int && data['Thuế, phí nhà nước'] >= 0
          && data['Tài chính & khác'] is int && data['Tài chính & khác'] >= 0;
      }
      allow get: if attendanceAdmin();
      allow create: if attendanceAdmin() && request.resource.data.keys().hasOnly(fields())
        && validBudget(request.resource.data);
      allow update: if attendanceAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields())
        && validBudget(request.resource.data);
    }

    match /settings/payroll {
      function fields() {
        return ['soDuDau', 'luongCoSo', 'lttVung', 'giamTruBanThan', 'giamTruPhuThuoc', 'ngayCongChuan',
          'nldBHXH', 'nldBHYT', 'nldBHTN', 'dnBHXH', 'dnTNLD', 'dnBHYT', 'dnBHTN', 'dnKPCD', 'updatedBy', 'updatedAt'];
      }
      function percent(value) {
        return value is number && value >= 0 && value <= 100;
      }
      function validPayroll(data) {
        return data.soDuDau is int && data.soDuDau >= 0 && data.luongCoSo is int && data.luongCoSo >= 0
          && data.lttVung is int && data.lttVung >= 0 && data.giamTruBanThan is int && data.giamTruBanThan >= 0
          && data.giamTruPhuThuoc is int && data.giamTruPhuThuoc >= 0
          && data.ngayCongChuan is number && data.ngayCongChuan >= 1 && data.ngayCongChuan <= 31
          && percent(data.nldBHXH) && percent(data.nldBHYT) && percent(data.nldBHTN)
          && percent(data.dnBHXH) && percent(data.dnTNLD) && percent(data.dnBHYT)
          && percent(data.dnBHTN) && percent(data.dnKPCD)
          && data.updatedBy == email() && isoDate(data.updatedAt);
      }
      allow get: if attendanceAdmin();
      allow create: if attendanceAdmin() && request.resource.data.keys().hasOnly(fields())
        && validPayroll(request.resource.data);
      allow update: if attendanceAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields())
        && validPayroll(request.resource.data);
    }

    match /recurring/{id} {
      function fields() {
        return ['name', 'category', 'amount', 'partyType', 'partyName', 'day', 'projectId', 'active'];
      }
      function validRecurring(data) {
        return shortText(data.name) && data.name.size() > 0 && shortText(data.category)
          && data.amount is int && data.amount > 0 && shortText(data.partyType) && shortText(data.partyName)
          && data.day is int && data.day >= 1 && data.day <= 28 && shortText(data.projectId) && data.active is bool;
      }
      allow read, delete: if attendanceAdmin();
      allow create: if attendanceAdmin() && request.resource.data.keys().hasOnly(fields())
        && validRecurring(request.resource.data);
      allow update: if attendanceAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields())
        && validRecurring(request.resource.data);
    }

    // cash/{id}: web-compatible ledger. Creator and creation time are immutable.
    // Only the assigned reviewer decides; a different recorder confirms movement with proof.
    // Employee profiles and monthly payslips use the web workspace document schema.
    function payrollMoney(value) {
      return value is int && value >= 0 && value <= 9007199254740991;
    }

    match /employees/{id} {
      function validEmployee(data) {
        return shortText(data.name) && data.name.size() > 0 && shortText(data.email)
          && (data.email == '' || data.email.matches('^[^ @/]+@[^ @/]+[.][^ @/]+$'))
          && shortText(data.position) && shortText(data.contract) && shortText(data.taxCode)
          && data.startDate is string && (data.startDate == '' || data.startDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
          && data.status in ['Đang làm', 'Đã nghỉ']
          && payrollMoney(data.salary) && payrollMoney(data.insSalary) && payrollMoney(data.allowTaxable)
          && payrollMoney(data.allowFree) && payrollMoney(data.dependents)
          && data.updatedBy == email() && isoDate(data.updatedAt);
      }
      allow read: if attendanceAdmin();
      allow create, update: if attendanceAdmin() && validEmployee(request.resource.data);
    }

    match /payroll/{id} {
      function validSlip(data) {
        return data.month is string && data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && data.empId is string && data.empId.size() > 0 && id == data.month + '_' + data.empId
          && shortText(data.name) && shortText(data.email) && data.status in ['Nháp', 'Đã chốt']
          && data.workDays is number && data.workDays >= 0 && data.workDays <= 31
          && data.standardDays is number && data.standardDays > 0 && data.standardDays <= 31
          && payrollMoney(data.salary) && payrollMoney(data.gross) && payrollMoney(data.bonus)
          && payrollMoney(data.deduction) && payrollMoney(data.insEmp) && payrollMoney(data.insCo)
          && payrollMoney(data.kpcd) && payrollMoney(data.taxable) && payrollMoney(data.pit)
          && payrollMoney(data.advance) && payrollMoney(data.companyCost) && data.net is int
          && data.net == data.gross - data.insEmp - data.pit - data.deduction - data.advance
          && data.companyCost == data.gross + data.insCo + data.kpcd
          && data.updatedBy == email() && isoDate(data.updatedAt)
          && !('employeeConfirmedAt' in data)
          && (data.status == 'Nháp' || (data.lockedBy == email() && data.lockedAt == data.updatedAt));
      }
      allow read: if activeMember() && (attendanceAdmin()
        || (resource.data.email == email() && resource.data.status in ['Đã chốt', 'Đã trả']));
      allow create: if attendanceAdmin() && validSlip(request.resource.data);
      allow update: if attendanceAdmin() && (
        (resource.data.get('status', 'Nháp') in ['', 'Nháp'] && validSlip(request.resource.data))
        || (resource.data.status == 'Đã chốt' && request.resource.data.status == 'Nháp'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy', 'employeeConfirmedAt'])
          && !('employeeConfirmedAt' in request.resource.data)
          && request.resource.data.updatedBy == email() && isoDate(request.resource.data.updatedAt))
      );
      allow update: if activeMember() && resource.data.email == email() && resource.data.status == 'Đã chốt'
        && !('employeeConfirmedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['employeeConfirmedAt'])
        && isoDate(request.resource.data.employeeConfirmedAt);
    }
    function hasCashGrant(account, grant) {
      let membership = get(/databases/$(database)/documents/members/$(account)).data;
      return membership.get('enabled', true) != false
        && (membership.get('role', '') == 'admin' || grant in membership.get('grants', []));
    }

    function canReadCash(data) {
      return hasCashGrant(email(), 'cashRecord')
        || data.get('createdBy', '') == email() || data.get('approverEmail', '') == email();
    }

    function canEditCashDraft(data) {
      return data.status == 'Chờ duyệt' && data.createdBy == email()
        && data.get('approvedBy', '') == '' && data.get('requestId', '') == '';
    }

    function cashFileEntry(id, meta, type) {
      return {'id': id, 'name': meta.name, 'size': meta.size, 'type': type};
    }

    // Attachments use the web's files/{id}/chunks/{index} layout. Each file is tied to a cash record.
    match /files/{fileId} {
      function projectFile(meta) {
        return meta.get('scopeType', '') == 'projects' && projectPart(meta.scopeId)
          && meta.parent == 'projects/' + meta.scopeId;
      }
      function readableProjectFile(meta) {
        return projectFile(meta) && projectDiscussionAccess(meta.scopeId);
      }
      function validProjectFile(meta) {
        let entry = getAfter(/databases/$(database)/documents/projects/$(meta.scopeId)/library/$(fileId)).data;
        return readableProjectFile(meta) && projectFileData(meta)
          && entry.name == meta.name && entry.type == meta.type && entry.size == meta.size
          && entry.createdBy == email() && entry.createdAt == request.time;
      }
      allow get: if readableProjectFile(resource.data);
      allow create: if projectFile(request.resource.data) && validProjectFile(request.resource.data);
      function cashPath(scopeId) {
        return /databases/$(database)/documents/cash/$(scopeId);
      }
      function fileScope(meta) {
        return meta.parent.split('/')[1];
      }
      function isCashFile(meta) {
        return meta.parent is string && meta.parent.matches('^cash/[^/]+$')
          && meta.get('scopeType', 'cash') == 'cash' && meta.get('scopeId', fileScope(meta)) == fileScope(meta);
      }
      function canReadFile(meta) {
        let cash = get(cashPath(fileScope(meta))).data;
        return canReadCash(cash) && cash.get('files', []).hasAny([
          cashFileEntry(fileId, meta, meta.type), cashFileEntry(fileId, meta, '')
        ]);
      }
      function validCashFile(meta) {
        let cash = getAfter(cashPath(meta.scopeId)).data;
        return meta.keys().hasOnly(['name', 'type', 'size', 'chunks', 'parent', 'scopeType', 'scopeId', 'by', 'at', 'sha256'])
          && isCashFile(meta) && canEditCashDraft(cash) && cash.updatedAt == meta.at
          && meta.by == email() && isoDate(meta.at)
          && meta.name is string && meta.name.size() <= 255 && meta.name.matches('(?s).*[^\\s].*')
          && meta.type is string && meta.type.size() <= 120 && meta.type.matches('^[a-zA-Z0-9.+_-]+/[a-zA-Z0-9.+_-]+$')
          && meta.size is int && meta.size > 0 && meta.size <= 5242880
          && meta.chunks is int && meta.chunks >= 1 && meta.chunks <= 6
          && meta.size > (meta.chunks - 1) * 921600 && meta.size <= meta.chunks * 921600
          && meta.sha256 is string && meta.sha256.matches('^[0-9a-f]{64}$')
          && cash.get('files', []).hasAny([cashFileEntry(fileId, meta, meta.type)]);
      }

      function isRecordAttachment(meta) {
        return meta.get('scopeType', '') == 'correspondence' && meta.scopeId is string
          && meta.parent == 'correspondence/' + meta.scopeId;
      }
      function recordPath(scopeId) {
        return /databases/$(database)/documents/correspondence/$(scopeId);
      }
      function readableRecordAttachment(meta) {
        return isRecordAttachment(meta) && recordReadable(get(recordPath(meta.scopeId)).data);
      }
      function validRecordAttachment(meta) {
        let record = getAfter(recordPath(meta.scopeId)).data;
        return meta.keys().hasOnly(['name','type','size','chunks','parent','scopeType','scopeId','by','at','sha256'])
          && isRecordAttachment(meta) && record.fileId == fileId && record.fileName == meta.name
          && record.updatedAt == request.time && record.updatedBy == email()
          && meta.by == email() && isoDate(meta.at)
          && meta.name is string && meta.name.size() > 0 && meta.name.size() <= 255
          && meta.type is string && meta.type.size() <= 120 && meta.type.matches('^[a-zA-Z0-9.+_-]+/[a-zA-Z0-9.+_-]+$')
          && meta.size is int && meta.size > 0 && meta.size <= 5242880
          && meta.chunks is int && meta.chunks >= 1 && meta.chunks <= 6
          && meta.size > (meta.chunks - 1) * 921600 && meta.size <= meta.chunks * 921600
          && meta.sha256 is string && meta.sha256.matches('^[0-9a-f]{64}$');
      }
      allow get: if activeMember() && isCashFile(resource.data) && canReadFile(resource.data);
      allow create: if activeMember() && isCashFile(request.resource.data) && validCashFile(request.resource.data);
      allow get: if activeMember() && readableRecordAttachment(resource.data);
      allow create: if recordAdmin() && validRecordAttachment(request.resource.data);

      match /chunks/{chunkId} {
        function filePath() {
          return /databases/$(database)/documents/files/$(fileId);
        }
        function readableCashChunk() {
          let meta = get(filePath()).data;
          return isCashFile(meta) && canReadFile(meta);
        }
        function validCashChunk(data) {
          let meta = getAfter(filePath()).data;
          return !exists(filePath()) && isCashFile(meta) && meta.by == email()
            && data.keys().hasOnly(['i', 'data']) && data.i is int && chunkId.matches('^[0-5]$')
            && int(chunkId) == data.i && data.i < meta.chunks && data.data is bytes
            && data.data.size() == (data.i == meta.chunks - 1 ? meta.size - data.i * 921600 : 921600);
        }
        function validRecordChunk(data) {
          let meta = getAfter(filePath()).data;
          return !exists(filePath()) && isRecordAttachment(meta) && meta.by == email()
            && data.keys().hasOnly(['i', 'data']) && data.i is int && chunkId.matches('^[0-5]$')
            && int(chunkId) == data.i && data.i < meta.chunks && data.data is bytes
            && data.data.size() == (data.i == meta.chunks - 1 ? meta.size - data.i * 921600 : 921600);
        }
        function validProjectChunk(data) {
          let meta = getAfter(filePath()).data;
          return !exists(filePath()) && readableProjectFile(meta) && meta.by == email()
            && data.keys().hasOnly(['i', 'data']) && data.i is int && chunkId.matches('^[0-5]$')
            && int(chunkId) == data.i && data.i < meta.chunks && data.data is bytes
            && data.data.size() == (data.i == meta.chunks - 1 ? meta.size - data.i * 921600 : 921600);
        }
        allow read: if readableProjectFile(get(filePath()).data);
        allow create: if validProjectChunk(request.resource.data);
        allow read: if activeMember() && readableCashChunk();
        allow create: if activeMember() && validCashChunk(request.resource.data);
        allow read: if activeMember() && readableRecordAttachment(get(filePath()).data);
        allow create: if recordAdmin() && validRecordChunk(request.resource.data);
      }
    }

    match /cash/{id} {
      function validSalaryAdvanceExpense(data) {
        let path = /databases/$(database)/documents/requests/$(data.requestId);
        let before = get(path).data;
        let after = getAfter(path).data;
        let fields = ['type', 'status', 'requestId', 'date', 'amount', 'category', 'method',
          'projectId', 'note', 'partyType', 'partyName', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy'];
        return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
          && id == 'tu_' + data.requestId && before.status == 'Chờ duyệt'
          && after.status == 'Đã duyệt' && after.type == 'Tạm ứng lương' && after.decidedBy == email()
          && data.type == 'chi' && data.status == 'Chờ duyệt' && data.amount == after.amount
          && data.amount is int && data.amount > 0 && data.category == 'Tạm ứng nhân viên'
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.method == 'Chuyển khoản' && data.projectId == '' && data.partyType == 'Nhân viên'
          && data.note is string && data.note.size() <= 280 && shortText(data.partyName)
          && data.createdBy == email() && data.updatedBy == email()
          && data.createdAt == after.decidedAt && data.updatedAt == after.decidedAt;
      }

      allow create: if activeMember() && id.matches('tu_.+') && validSalaryAdvanceExpense(request.resource.data);
      function dateOnly(value) {
        return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
      }
      function cashFields() {
        return ['type', 'date', 'dueDate', 'amount', 'category', 'method', 'projectId',
          'note', 'partyType', 'partyName', 'invoiceRef'];
      }
      function validCashCore(data) {
        return data.type in ['thu', 'chi'] && dateOnly(data.date)
          && data.amount is int && data.amount > 0 && data.amount <= 9007199254740991
          && data.createdBy is string && data.createdBy.size() > 0 && data.createdBy.size() <= 250
          && data.status in ['Chờ duyệt', 'Chờ chi', 'Chờ thu', 'Đã chi', 'Đã thu', 'Từ chối']
          && data.updatedBy == email() && isoDate(data.updatedAt);
      }
      function validCashDraft(data) {
        return validCashCore(data) && data.status == 'Chờ duyệt'
          && (data.dueDate == '' || dateOnly(data.dueDate))
          && shortText(data.category) && data.category.size() > 0 && shortText(data.projectId)
          && (data.method == 'Chuyển khoản' || (data.type == 'thu' && data.method == 'Tiền mặt'))
          && data.note is string && data.note.size() <= 1000 && data.note.matches('(?s).*[^\\s].*')
          && shortText(data.partyType) && shortText(data.partyName)
          && data.invoiceRef is string && data.invoiceRef.size() <= 150;
      }
      function validNewProjectExpense(data) {
        return !data.keys().hasAny(['budgetCode', 'budgetFlow', 'expenseProfile', 'projectLinkLocked'])
          || (data.projectId != '' && !data.projectId.matches('.*/.*')
            && exists(/databases/$(database)/documents/projects/$(data.projectId))
            && data.budgetCode is string && data.budgetCode.matches('^([A-Z0-9][A-Z0-9._-]{0,79})?$')
            && ((data.type == 'chi' && data.projectLinkLocked == true && data.budgetFlow == 'out'
                && data.expenseProfile in ['project', 'fnb'])
              || (data.type == 'thu' && !data.keys().hasAny(['expenseProfile', 'projectLinkLocked'])
                && data.budgetFlow in ['depositReturn', 'expenseRefund'] && data.budgetCode != '' && data.category == 'Thu khác')));
      }
      function eligibleApprover(account, creator) {
        return account is string && account.size() <= 250
          && account.matches('^[^ @/]+@[^ @/]+[.][^ @/]+$') && account != creator
          && exists(/databases/$(database)/documents/members/$(account)) && hasCashGrant(account, 'cashReview');
      }
      function verifiedApproval(data) {
        return data.get('approvedBy', '') is string && data.get('approvedBy', '') != ''
          && data.get('approvedBy', '') != data.createdBy;
      }
      function awaitingMoney(data) {
        return data.status == (data.type == 'chi' ? 'Chờ chi' : 'Chờ thu');
      }
      function onlyCashChanges(fields) {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields.concat(['updatedBy', 'updatedAt']));
      }
      function validAddedFile(before, after, index, at) {
        let entry = after[index];
        let meta = getAfter(/databases/$(database)/documents/files/$(entry.id)).data;
        return !before.hasAny([entry]) && entry == cashFileEntry(entry.id, meta, meta.type)
          && meta.parent == 'cash/' + id && meta.scopeType == 'cash' && meta.scopeId == id
          && meta.by == email() && meta.at == at;
      }
      function validCashFiles(before, after, at) {
        let start = before.size();
        let count = after.size() - start;
        return before == after || (count > 0 && count <= 5 && (start == 0 || after[0:start] == before)
          && validAddedFile(before, after, start, at)
          && (count < 2 || validAddedFile(before, after, start + 1, at))
          && (count < 3 || validAddedFile(before, after, start + 2, at))
          && (count < 4 || validAddedFile(before, after, start + 3, at))
          && (count < 5 || validAddedFile(before, after, start + 4, at)));
      }
      function validCashUpdate(before, after) {
        return validCashCore(after) && (
          (before.status == 'Chờ duyệt' && (
            (onlyCashChanges(cashFields().concat(['files'])) && canEditCashDraft(before)
              && after.type == before.type && validCashDraft(after)
              && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['files'])
                || (after.files is list && validCashFiles(before.get('files', []), after.files, after.updatedAt)))
              && (!(before.get('projectLinkLocked', false) || before.get('budgetFlow', '') in ['depositReturn', 'expenseRefund'])
                || after.projectId == before.projectId)
              && (!(before.get('budgetFlow', '') in ['depositReturn', 'expenseRefund']) || after.category == 'Thu khác'))
            || (attendanceAdmin() && after.status == before.status && onlyCashChanges(['approverEmail'])
              && eligibleApprover(after.approverEmail, before.createdBy))
            || (before.get('approverEmail', '') == email() && before.createdBy != email()
              && hasCashGrant(email(), 'cashReview') && onlyCashChanges(['status', 'approvedBy', 'approvedAt', 'approvalNote'])
              && after.approvedBy == email() && after.approvedAt == after.updatedAt
              && after.approvalNote is string && after.approvalNote.size() <= 500
              && (awaitingMoney(after) || (after.status == 'Từ chối' && after.approvalNote.matches('(?s).*[^\\s].*'))))
          ))
          || (awaitingMoney(before) && (
            (hasCashGrant(email(), 'cashRecord') && verifiedApproval(before) && before.approvedBy != email()
              && (before.type == 'thu' || before.method == 'Chuyển khoản')
              && onlyCashChanges(['status', 'ref', 'paidBy', 'paidAt'])
              && after.status == (before.type == 'chi' ? 'Đã chi' : 'Đã thu')
              && after.paidBy == email() && after.paidAt == after.updatedAt
              && after.ref is string && after.ref.size() <= 150 && after.ref.matches('(?s).*[^\\s].*'))
            || (attendanceAdmin() && !verifiedApproval(before) && !('legacyApproval' in before)
              && onlyCashChanges(['status', 'approvedBy', 'approvedAt', 'legacyApproval'])
              && after.status == 'Chờ duyệt' && after.approvedBy == '' && after.approvedAt == ''
              && after.legacyApproval == {'by': before.get('approvedBy', ''), 'at': before.get('approvedAt', '')})
          ))
        );
      }
      function validGeneratedExpense(data) {
        let dateParts = data.date.split('-');
        return data.keys().hasOnly(['type', 'date', 'amount', 'category', 'method', 'projectId', 'note',
          'partyType', 'partyName', 'status', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
          && data.type == 'chi' && data.method == 'Chuyển khoản' && data.status == 'Chờ duyệt'
          && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && id.matches('cd_' + dateParts[0] + '-' + dateParts[1] + '_.+')
          && data.amount is int && data.amount > 0 && shortText(data.category) && shortText(data.projectId)
          && data.note is string && data.note.size() <= 280 && shortText(data.partyType) && shortText(data.partyName)
          && data.createdBy == email() && data.updatedBy == email() && isoDate(data.createdAt) && isoDate(data.updatedAt);
      }
      function validPayrollExpense(data) {
        return data.keys().hasOnly(['type', 'date', 'amount', 'category', 'method', 'projectId', 'note',
          'partyType', 'partyName', 'partyEmail', 'status', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'])
          && validCashCore(data) && data.type == 'chi' && data.status == 'Chờ chi'
          && data.method == 'Chuyển khoản' && data.projectId == '' && data.createdBy == email()
          && data.createdAt == data.updatedAt && shortText(data.partyName)
          && data.note is string && data.note.size() > 0 && data.note.size() <= 320
          && ((id.matches('luong_[0-9]{4}-[0-9]{2}_.+') && data.category == 'Lương'
              && data.partyType == 'Nhân viên' && shortText(data.partyEmail))
            || (data.partyType == 'Cơ quan nhà nước' && !('partyEmail' in data)
              && ((id.matches('bhxh_[0-9]{4}-[0-9]{2}') && data.category == 'BHXH, BHYT, BHTN')
                || (id.matches('kpcd_[0-9]{4}-[0-9]{2}') && data.category == 'Kinh phí công đoàn')
                || (id.matches('tncn_[0-9]{4}-[0-9]{2}') && data.category == 'Thuế TNCN nộp thay'))));
      }
      allow read: if activeMember() && canReadCash(resource.data);
      allow create: if activeMember() && !id.matches('tu_.+') && (
        (!id.matches('^(cd|luong|bhxh|kpcd|tncn)_.*') && request.resource.data.keys().hasOnly(cashFields().concat(['approverEmail', 'ref', 'status',
          'createdBy', 'createdAt', 'updatedBy', 'updatedAt', 'files', 'budgetCode', 'budgetFlow', 'expenseProfile', 'projectLinkLocked']))
          && validCashDraft(request.resource.data) && request.resource.data.createdBy == email()
          && validNewProjectExpense(request.resource.data)
          && request.resource.data.get('files', []) is list
          && validCashFiles([], request.resource.data.get('files', []), request.resource.data.updatedAt)
          && request.resource.data.createdAt == request.resource.data.updatedAt && request.resource.data.ref == ''
          && (request.resource.data.approverEmail == '' || (attendanceAdmin()
            && eligibleApprover(request.resource.data.approverEmail, email()))))
        || (attendanceAdmin() && (validGeneratedExpense(request.resource.data) || validPayrollExpense(request.resource.data)))
      );
      allow update: if activeMember() && validCashUpdate(resource.data, request.resource.data);
    }

    // weekPlans/{email}_{Monday}: shared with the web workspace.
    match /weekPlans/{id} {
      function validWeekPlan(data) {
        let fields = ['email', 'week', 'priorities', 'blockers', 'updatedAt'];
        return data.keys().hasAll(fields) && data.keys().hasOnly(fields)
          && data.email == email()
          && data.week is string && data.week.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && id == data.email + '_' + data.week
          && data.priorities is string && data.priorities.size() <= 2000
          && data.blockers is string && data.blockers.size() <= 2000
          && isoDate(data.updatedAt);
      }

      allow read: if activeMember() && (hasMemberGrant('weekPlanRead') || resource.data.email == email());
      allow create: if activeMember() && validWeekPlan(request.resource.data);
      allow update: if activeMember() && resource.data.email == email()
        && request.resource.data.week == resource.data.week && validWeekPlan(request.resource.data);
    }

    match /requests/{id} {
      function requestReviewer(memberEmail) {
        let profile = get(/databases/$(database)/documents/members/$(memberEmail)).data;
        return profile.get('enabled', true) != false
          && (profile.get('role', '') == 'admin' || 'requestReview' in profile.get('grants', []));
      }

      function validApprover(memberEmail, creator) {
        return memberEmail is string && memberEmail.size() <= 320
          && memberEmail.matches('^[^/@]+@[^/@]+$') && memberEmail != creator && requestReviewer(memberEmail);
      }

      function requestContentFields() {
        return ['type', 'from', 'to', 'days', 'amount', 'month', 'reason'];
      }

      function requestOptionalFields() {
        return ['trip', 'overtime', 'leaveTime'];
      }

      function validTrip(data) {
        let trip = data.trip;
        return trip is map && trip.keys().hasOnly(['destination', 'host', 'estimatedCost', 'time'])
          && shortText(trip.destination) && trip.destination.matches('(?s).*[^\\s].*')
          && shortText(trip.host) && trip.estimatedCost is int
          && trip.estimatedCost >= 0 && trip.estimatedCost <= 999999999999999
          && (!('time' in trip) || (data.type == 'Công tác' && validRequestTime(data, trip.time)));
      }

      function validOvertimeTask(taskId, title) {
        return taskId is string && taskId.matches('^[^/]{1,250}$')
          && shortText(title) && title.matches('(?s).*[^\\s].*');
      }

      function validOvertimeTaskAt(tasks, index) {
        return tasks.size() <= index || (tasks[index] is map
          && tasks[index].keys().hasOnly(['id', 'title'])
          && validOvertimeTask(tasks[index].id, tasks[index].title));
      }

      function validOvertimeTasks(tasks) {
        return tasks is list && tasks.size() >= 1 && tasks.size() <= 10
          && validOvertimeTaskAt(tasks, 0) && validOvertimeTaskAt(tasks, 1)
          && validOvertimeTaskAt(tasks, 2) && validOvertimeTaskAt(tasks, 3)
          && validOvertimeTaskAt(tasks, 4) && validOvertimeTaskAt(tasks, 5)
          && validOvertimeTaskAt(tasks, 6) && validOvertimeTaskAt(tasks, 7)
          && validOvertimeTaskAt(tasks, 8) && validOvertimeTaskAt(tasks, 9);
      }

      function validOvertime(overtime) {
        return overtime is map && overtime.hours is number && overtime.hours > 0 && overtime.hours <= 24
          && ((overtime.keys().hasOnly(['hours', 'tasks']) && validOvertimeTasks(overtime.tasks))
            || (overtime.keys().hasOnly(['hours', 'taskId', 'taskTitle'])
              && validOvertimeTask(overtime.taskId, overtime.taskTitle)));
      }

      function validRequestDay(value) {
        return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }

      function validRequestClock(value) {
        return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
      }

      function validRequestTime(data, time) {
        return data.from != '' && data.to != ''
          && time is map && time.keys().hasOnly(['from', 'to'])
          && validRequestClock(time.from) && validRequestClock(time.to)
          && (data.from < data.to || time.from < time.to);
      }

      function validRequestContent(data) {
        return data.keys().hasAll(requestContentFields())
          && data.type in ['Nghỉ phép', 'Tạm ứng lương', 'Công tác', 'Làm thêm giờ', 'Đề xuất khác']
          && validRequestDay(data.from) && validRequestDay(data.to)
          && (data.from == '' || data.to == '' || data.from <= data.to)
          && data.days is number && data.days >= 0 && data.days <= 366 && data.days * 2 == int(data.days * 2)
          && data.amount is int && data.amount >= 0 && data.amount <= 999999999999999
          && data.month is string && (data.month == '' || data.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'))
          && (data.type != 'Tạm ứng lương' || (data.amount > 0 && data.month != ''))
          && (!('trip' in data) || validTrip(data))
          && (!('overtime' in data) || validOvertime(data.overtime))
          && (!('leaveTime' in data) || (data.type == 'Nghỉ phép' && validRequestTime(data, data.leaveTime)))
          && data.reason is string && data.reason.size() <= 2000 && data.reason.matches('(?s).*[^\\s].*');
      }

      function validRequestAudit(data) {
        return data.updatedBy == email() && isoDate(data.updatedAt);
      }

      function validRequestCreate(data) {
        return data.keys().hasOnly(requestContentFields().concat(requestOptionalFields()).concat(
          ['status', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'approverEmail']))
          && validRequestContent(data) && validRequestAudit(data)
          && data.status == 'Chờ duyệt' && data.createdBy == email() && data.createdAt == data.updatedAt
          && (data.get('approverEmail', '') == '' || validApprover(data.approverEmail, data.createdBy));
      }

      function validRequestDecision(data) {
        let cash = /databases/$(database)/documents/cash/$('tu_' + id);
        return resource.data.get('approverEmail', '') == email() && resource.data.createdBy != email()
          && requestReviewer(email()) && data.status in ['Đã duyệt', 'Từ chối']
          && data.decidedBy == email() && data.decidedAt == data.updatedAt
          && data.reply is string && data.reply.size() <= 500
          && (data.status != 'Từ chối' || data.reply.matches('(?s).*[^\\s].*'))
          && (data.status != 'Đã duyệt' || data.type != 'Tạm ứng lương'
            || (!exists(cash) && existsAfter(cash) && getAfter(cash).data.requestId == id));
      }

      function validRequestUpdate(data) {
        let changed = data.diff(resource.data).affectedKeys();
        return resource.data.status == 'Chờ duyệt' && validRequestAudit(data) && (
          (resource.data.createdBy == email()
            && changed.hasOnly(requestContentFields().concat(requestOptionalFields()).concat(['updatedAt', 'updatedBy']))
            && validRequestContent(data))
          || (attendanceAdmin() && changed.hasOnly(['approverEmail', 'updatedAt', 'updatedBy'])
            && validApprover(data.approverEmail, data.createdBy))
          || (changed.hasOnly(['status', 'decidedBy', 'decidedAt', 'reply', 'updatedAt', 'updatedBy'])
            && validRequestDecision(data)));
      }

      allow read: if activeMember() && (attendanceAdmin() || resource.data.createdBy == email()
        || (resource.data.approverEmail == email() && requestReviewer(email())));
      allow create: if activeMember() && validRequestCreate(request.resource.data);
      allow update: if activeMember() && validRequestUpdate(request.resource.data);
      allow delete: if activeMember() && (attendanceAdmin()
        || (resource.data.createdBy == email() && resource.data.status == 'Chờ duyệt'));
    }

    // attendance/{email}_{YYYY-MM-DD}: machine timestamps and optional administrative adjustments.
    match /attendance/{id} {
      function validAttendance(data) {
        return data.keys().hasAll(['email', 'name', 'date'])
          && data.email is string && data.name is string && data.name.size() <= 320
          && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && id == data.email + '_' + data.date;
      }

      function validDistance(distance) {
        return distance == null || (distance is int && distance >= 0 && distance <= 20020000);
      }

      function validTime(time) {
        return time is string && (time == '' || time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
      }

      function validAdjustment(data) {
        return data.editedBy == email() && validTime(data.manualIn) && validTime(data.manualOut)
          && data.note is string && data.note.size() <= 1000 && data.note.matches('(?s).*[^\\s].*')
          && data.get('manualWork', '') in ['', 0, 0.5, 1];
      }

      function adjustmentFields() {
        return ['email', 'name', 'date', 'manualIn', 'manualOut', 'manualWork', 'note', 'editedBy'];
      }

      allow read: if activeMember() && (attendanceAdmin() || resource.data.email == email());
      allow create: if activeMember() && validAttendance(request.resource.data) && (
        (request.resource.data.email == email()
          && request.resource.data.keys().hasOnly(['email', 'name', 'date', 'inTs', 'inDist'])
          && request.resource.data.inTs == request.time && validDistance(request.resource.data.inDist))
        || (attendanceAdmin() && request.resource.data.keys().hasOnly(adjustmentFields())
          && validAdjustment(request.resource.data)));
      allow update: if activeMember() && validAttendance(request.resource.data) && (
        (resource.data.email == email()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outTs', 'outDist'])
          && request.resource.data.outTs == request.time && validDistance(request.resource.data.outDist))
        || (attendanceAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(adjustmentFields())
          && validAdjustment(request.resource.data)));
      allow delete: if attendanceAdmin();
    }

    // Personal notes are independent of punch records and adjustment reasons.
    match /members/{owner}/attendanceNotes/{date} {
      function ownsNotes() {
        return activeMember() && owner == email();
      }

      function validNote(data) {
        return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && data.keys().hasOnly(['text'])
          && data.text is string && data.text.size() <= 1000 && data.text.matches('(?s).*[^\\s].*');
      }

      allow read, delete: if ownsNotes();
      allow create, update: if ownsNotes() && validNote(request.resource.data);
    }

    function projectPart(value) {
      return value is string && value.size() <= 120 && value.matches('^[^/]+$') && !(value in ['.', '..']);
    }
    function projectDiscussionAccess(projectId) {
      let project = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return activeMember() && project != null
        && (attendanceAdmin() || project.get('ownerEmail', '') == email() || email() in project.get('collaborators', []));
    }
    function projectDiscussionManager(projectId) {
      return projectDiscussionAccess(projectId)
        && (attendanceAdmin() || get(/databases/$(database)/documents/projects/$(projectId)).data.get('ownerEmail', '') == email());
    }
    function projectFileData(meta) {
      return meta.keys().hasOnly(['name','type','size','chunks','parent','scopeType','scopeId','by','at','sha256'])
        && meta.by == email() && isoDate(meta.at)
        && meta.name is string && meta.name.size() > 0 && meta.name.size() <= 255
        && meta.type is string && meta.type.size() <= 120 && meta.type.matches('^[a-zA-Z0-9.+_-]+/[a-zA-Z0-9.+_-]+$')
        && meta.size is int && meta.size > 0 && meta.size <= 5242880
        && meta.chunks is int && meta.chunks >= 1 && meta.chunks <= 6
        && meta.size > (meta.chunks - 1) * 921600 && meta.size <= meta.chunks * 921600
        && meta.sha256 is string && meta.sha256.matches('^[0-9a-f]{64}$');
    }

    // Collaboration shares project-scoped metadata and private files with the web workspace.
    // Project profile mirrors the web's flat fields. Financial records use separate collections.
    match /projects/{id} {
      function activeMember() {
        return member()
          && get(/databases/$(database)/documents/members/$(email())).data.get('enabled', true) != false;
      }

      function projectAdmin() {
        return activeMember()
          && get(/databases/$(database)/documents/members/$(email())).data.get('role', '') == 'admin';
      }

      function profileFields() {
        return ['name', 'owner', 'ownerEmail', 'status', 'budget', 'startDate', 'deadline', 'goal', 'phase', 'risks', 'note'];
      }

      function boundedText(value, max) {
        return value is string && value.size() <= max;
      }

      function projectDate(value) {
        return value is string && (value == '' || value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }

      function validProject(data) {
        return data.keys().hasAll(profileFields())
          && boundedText(data.name, 320) && data.name.matches('(?s).*[^\\s].*')
          && boundedText(data.owner, 320) && boundedText(data.ownerEmail, 320)
          && (data.ownerEmail == '' || data.ownerEmail.matches('^[^\\s@]+@[^\\s@]+[.][^\\s@]+$'))
          && data.status in ['Đang chạy', 'Tạm dừng', 'Xong']
          && data.budget is int && data.budget >= 0 && data.budget <= 9007199254740991
          && projectDate(data.startDate) && projectDate(data.deadline)
          && boundedText(data.phase, 320) && boundedText(data.goal, 4000)
          && boundedText(data.risks, 4000) && boundedText(data.note, 4000);
      }

      allow read: if activeMember();
      allow create: if hasMemberGrant('projectManage') && validProject(request.resource.data)
        && request.resource.data.keys().hasOnly(profileFields())
        && (projectAdmin() || (request.resource.data.ownerEmail == '' && request.resource.data.owner == ''));
      allow update: if hasMemberGrant('projectManage') && validProject(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileFields())
        && (projectAdmin() || (request.resource.data.ownerEmail == resource.data.get('ownerEmail', '')
          && request.resource.data.owner == resource.data.get('owner', '')));
      allow update: if projectAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborators'])
        && request.resource.data.collaborators is list && request.resource.data.collaborators.size() <= 50;

      function projectFolderPath(path) {
        return boundedText(path, 500) && path.matches('^[^/]+(/[^/]+)*$')
          && !path.matches('(^|.*/)\\.{1,2}(/.*|$)');
      }
      function linkedProjectFile(file) {
        let entry = getAfter(/databases/$(database)/documents/projects/$(id)/library/$(file.id)).data;
        return projectPart(file.id) && file == {'id': file.id, 'name': entry.name, 'type': entry.type, 'size': entry.size}
          && entry.createdBy == email() && entry.createdAt == request.time && entry.folderPath == 'Trao đổi';
      }
      function projectPostFiles(files) {
        return files is list && files.size() <= 5
          && (files.size() < 1 || linkedProjectFile(files[0]))
          && (files.size() < 2 || linkedProjectFile(files[1]))
          && (files.size() < 3 || linkedProjectFile(files[2]))
          && (files.size() < 4 || linkedProjectFile(files[3]))
          && (files.size() < 5 || linkedProjectFile(files[4]));
      }
      function projectPostText(value, max) {
        return boundedText(value, max) && value.matches('(?s).*[^\\s].*');
      }

      match /folders/{folderId} {
        allow read: if projectDiscussionAccess(id);
        allow create: if projectDiscussionAccess(id) && folderId.matches('^[a-f0-9]{20}$')
          && request.resource.data.keys().hasOnly(['path', 'createdBy', 'createdAt'])
          && projectFolderPath(request.resource.data.path)
          && request.resource.data.createdBy == email() && request.resource.data.createdAt == request.time;
      }
      match /library/{fileId} {
        function validLibraryEntry(data) {
          let meta = getAfter(/databases/$(database)/documents/files/$(fileId)).data;
          return !exists(/databases/$(database)/documents/files/$(fileId))
            && data.keys().hasOnly(['name', 'type', 'size', 'folderPath', 'createdBy', 'createdAt', 'updatedAt'])
            && meta.parent == 'projects/' + id && meta.scopeType == 'projects' && meta.scopeId == id
            && data.name == meta.name && data.type == meta.type && data.size == meta.size
            && data.createdBy == email() && data.createdAt == request.time;
        }
        allow read: if projectDiscussionAccess(id);
        allow create: if projectDiscussionAccess(id) && validLibraryEntry(request.resource.data)
          && projectFolderPath(request.resource.data.folderPath) && request.resource.data.updatedAt == request.time;
        allow update: if projectDiscussionAccess(id) && (projectAdmin() || resource.data.createdBy == email())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['folderPath', 'updatedAt'])
          && projectFolderPath(request.resource.data.folderPath) && request.resource.data.updatedAt == request.time;
        // Discussion attachments can still reference the corresponding document in /files.
        allow delete: if projectDiscussionAccess(id) && (projectAdmin() || resource.data.createdBy == email());
      }
      match /posts/{postId} {
        function validPost(data) {
          return data.keys().hasOnly(['title', 'body', 'kind', 'taskId', 'mentions', 'files', 'status', 'pinned',
              'conclusion', 'createdBy', 'createdAt', 'updatedAt'])
            && projectPostText(data.title, 200) && projectPostText(data.body, 10000)
            && data.kind in ['Cập nhật', 'Hỏi đáp', 'Báo vướng', 'Xin quyết định']
            && (data.taskId == '' || (projectPart(data.taskId)
              && get(/databases/$(database)/documents/tasks/$(data.taskId)).data.projectId == id))
            && data.mentions is list && data.mentions.size() <= 50 && projectPostFiles(data.files)
            && data.pinned == false && data.status == 'open' && data.conclusion == ''
            && data.createdBy == email() && data.createdAt == request.time && data.updatedAt == request.time;
        }
        function validPostUpdate(data) {
          let fields = data.diff(resource.data).affectedKeys();
          return data.updatedAt == request.time &&
            ((projectDiscussionManager(id) && fields.hasOnly(['pinned', 'updatedAt']) && data.pinned is bool)
              || ((projectDiscussionManager(id) || resource.data.createdBy == email())
                && fields.hasOnly(['status', 'conclusion', 'updatedAt'])
                && ((data.status == 'resolved' && projectPostText(data.conclusion, 5000))
                  || (data.status == 'open' && data.conclusion == resource.data.conclusion))));
        }
        allow read: if projectDiscussionAccess(id);
        allow create: if projectDiscussionAccess(id) && validPost(request.resource.data);
        allow update: if projectDiscussionAccess(id) && validPostUpdate(request.resource.data);

        match /comments/{commentId} {
          function validComment(data) {
            return data.keys().hasOnly(['body', 'replyTo', 'files', 'createdBy', 'createdAt'])
              && projectPostText(data.body, 5000) && projectPostFiles(data.files)
              && data.createdBy == email() && data.createdAt == request.time
              && (data.replyTo == '' || (projectPart(data.replyTo) &&
                exists(/databases/$(database)/documents/projects/$(id)/posts/$(postId)/comments/$(data.replyTo))));
          }
          allow read: if projectDiscussionAccess(id);
          allow create: if projectDiscussionAccess(id)
            && exists(/databases/$(database)/documents/projects/$(id)/posts/$(postId))
            && validComment(request.resource.data);
        }
        match /reactions/{actor} {
          allow get, delete: if projectDiscussionAccess(id) && actor == email();
          allow create: if projectDiscussionAccess(id) && actor == email()
            && exists(/databases/$(database)/documents/projects/$(id)/posts/$(postId))
            && request.resource.data.keys().hasOnly(['by', 'at'])
            && request.resource.data.by == email() && request.resource.data.at == request.time;
        }
      }

      function ownFinanceWrite(data) {
        return projectAdmin() && exists(/databases/$(database)/documents/projects/$(id))
          && data.by == email() && data.at == request.time
          && data.revision is int && data.revision > 0 && data.revision <= 9007199254740991
          && data.lines is list && data.lines.size() <= 30;
      }

      function optionalFinanceMoney(value) {
        return value == null || (value is int && value >= 0 && value <= 1000000000000);
      }

      // The web and mobile clients share one mutable draft and immutable approved snapshots.
      match /finance/draft {
        function validDraft(data) {
          return ownFinanceWrite(data)
            && data.keys().hasOnly(['revision', 'by', 'at', 'lines', 'opening', 'reserve', 'price',
              'variable', 'fixed', 'days', 'guests', 'start', 'weeks'])
            && optionalFinanceMoney(data.opening) && optionalFinanceMoney(data.reserve)
            && optionalFinanceMoney(data.price) && optionalFinanceMoney(data.variable) && optionalFinanceMoney(data.fixed)
            && (data.days == null || (data.days is int && data.days >= 1 && data.days <= 31))
            && (data.guests == null || (data.guests is int && data.guests >= 0 && data.guests <= 100000))
            && projectDate(data.start) && data.weeks is list && data.weeks.size() == 13;
        }
        allow get: if projectAdmin();
        allow create: if validDraft(request.resource.data) && request.resource.data.revision == 1;
        allow update: if validDraft(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1;
      }

      match /budgetVersions/{version} {
        function validVersion(data) {
          let draft = get(/databases/$(database)/documents/projects/$(id)/finance/draft).data;
          return ownFinanceWrite(data) && data.keys().hasOnly(['revision', 'by', 'at', 'lines', 'reason'])
            && version == string(data.revision) && data.revision == draft.revision
            && data.lines == draft.lines && data.lines.size() > 0
            && boundedText(data.reason, 1000) && data.reason.size() > 0;
        }
        allow read: if projectAdmin();
        allow create: if validVersion(request.resource.data);
      }
    }

    // Shared web inbox. Trusted senders supply to, from, title, body, link and createdAt.
    // Recipients can only change read to true. The optional emailed flag is server-managed.
    function recordChanges() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Sổ văn thư: khóa số sổ theo chiều/năm, nhật ký bất biến và một tệp đính kèm.
    function recordActive(mail) {
      return mail is string && mail != '' && get(/databases/$(database)/documents/members/$(mail)).data.get('enabled', true) == true;
    }
    function recordMember() { return activeMember(); }
    function recordAdmin() { return hasMemberGrant('recordManage'); }
    function recordReadable(d) {
      return recordAdmin() || (recordMember() && (d.assigneeEmail == email() || email() in d.get('watchers',[])));
    }
    function recordWatchers(w) {
      return w is list && w.size() <= 5 && w.toSet().size() == w.size();
    }
    function recordWatcherAt(w, old, i) {
      return w.size() <= i || w[i] in old || recordActive(w[i]);
    }
    function recordWatcherChange(w, old) {
      return recordWatchers(w)
        && recordWatcherAt(w, old, 0) && recordWatcherAt(w, old, 1) && recordWatcherAt(w, old, 2)
        && recordWatcherAt(w, old, 3) && recordWatcherAt(w, old, 4);
    }
    function recordNotification(n, id) {
      let d = getAfter(/databases/$(database)/documents/correspondence/$(n.recordId)).data;
      let event = getAfter(/databases/$(database)/documents/correspondence/$(n.recordId)/events/$(n.eventId)).data;
      return n.from == email() && n.keys().hasOnly(['to','from','title','body','link','createdAt','read','emailed','kind','recordId','eventId'])
        && n.recordId is string && n.to is string && n.to != email()
        && recordIdPart(n.eventId) && id == n.eventId + '_' + n.to
        && d.lastEventId == n.eventId && d.updatedBy == email() && event.actor == email() && event.at == d.updatedAt
        && n.to in d.get('watchers',[])
        && n.title == 'Văn thư có cập nhật' && n.body == 'Mở hồ sơ để xem chi tiết.'
        && n.link == '#van-thu/' + n.recordId
        && n.createdAt is string && n.createdAt.size() <= 35 && n.read == false && n.emailed == false;
    }
    function recordDate(value) {
      return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    function recordIdPart(value) {
      return value is string && value.matches('^[A-Za-z0-9]{20}$');
    }
    // Mỗi dãy theo năm Việt Nam. Tăng bộ đếm, cấp số và ghi nhật ký trong cùng một lần lưu.
    function recordClock() { return request.time + duration.value(7, 'h'); }
    function recordDigits(value) { return (value < 10 ? '0' : '') + string(value); }
    function recordToday() {
      let now = recordClock();
      return string(now.year()) + '-' + recordDigits(now.month()) + '-' + recordDigits(now.day());
    }
    function recordSeries(d) { return d.direction == 'in' ? 'in' : d.get('kind','letter'); }
    function recordSequenceShape(n) {
      return n is map && n.keys().hasOnly(['year','seq','at'])
        && n.year is int && n.seq is int && n.seq >= 1 && n.seq <= 999999 && n.at is timestamp;
    }
    function recordAllocation(d, id) {
      let n = d.numbering;
      let series = recordSeries(d);
      let counter = getAfter(/databases/$(database)/documents/recordCounters/$(series + '-' + string(n.year))).data;
      return recordSequenceShape(n) && n.year == recordClock().year() && n.at == request.time
        && counter.recordId == id && counter.last == n.seq && counter.updatedAt == request.time
        && (d.direction == 'in' ? d.serial == string(n.seq)
          : d.documentOn == recordToday()
            && d.externalNumber == recordDigits(n.seq) + (series == 'decision' ? '/QĐ-MARCHIX' : '/MARCHIX-VP'));
    }
    function counterShape(c, id) {
      let record = getAfter(/databases/$(database)/documents/correspondence/$(c.recordId)).data;
      return c.keys().hasOnly(['last','recordId','updatedAt'])
        && c.recordId is string && c.last is int && c.last >= 1 && c.last <= 999999
        && c.updatedAt == request.time && record.numbering.at == request.time
        && record.numbering.seq == c.last && record.numbering.year == recordClock().year()
        && (record.direction == 'in' || record.status == 'numbered')
        && id == recordSeries(record) + '-' + string(record.numbering.year);
    }
    match /recordCounters/{id} {
      allow get: if recordMember();
      allow create: if recordMember() && request.resource.data.last == 1 && counterShape(request.resource.data, id);
      allow update: if recordMember() && request.resource.data.last == resource.data.last + 1
        && request.resource.data.recordId != resource.data.recordId && counterShape(request.resource.data, id);
      allow delete: if false;
    }
    function recordShape(d, id) {
      let signedBy = d.get('signedByName','');
      let signedOn = d.get('signedOn','');
      let numbering = d.get('numbering',null);
      return d.keys().hasOnly(['direction','year','serial','registeredOn','documentOn',
          'externalNumber','subject','partner','assigneeEmail','dueOn','priority','status',
          'createdBy','createdAt','updatedBy','updatedAt','lastEventId','fileId','fileName','kind','numbering','watchers','signedByName','signedOn'])
        && d.direction in ['in','out'] && d.year is string && d.year.matches('^20[0-9]{2}$')
        && d.get('kind','letter') in ['letter','decision']
        && (d.direction == 'in' || numbering == null || recordSequenceShape(d.numbering))
        && d.serial is string
        && (d.serial == '' && d.direction == 'out' && recordIdPart(id)
          || d.serial.matches('^[1-9][0-9]{0,5}$') && id == d.direction + '-' + d.year + '-' + d.serial)
        && recordDate(d.registeredOn) && d.registeredOn.matches('^' + d.year + '-.*')
        && (d.documentOn == '' || recordDate(d.documentOn))
        && (d.dueOn == '' || recordDate(d.dueOn))
        && d.externalNumber is string && d.externalNumber.size() <= 100
        && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 240
        && d.partner is string && d.partner.size() > 0 && d.partner.size() <= 160
        && d.assigneeEmail is string && d.assigneeEmail.size() <= 254
        && d.priority in ['normal','urgent']
        && (d.direction == 'in' && d.status in ['registered','assigned','processing','completed','archived']
          || d.direction == 'out' && d.status in ['draft','review','approved','signing','signed','numbered','issued','void','archived'])
        && (d.status != 'issued' || d.externalNumber.size() > 0 && signedBy != '' && d.fileId != '')
        && (signedBy is string && signedBy.size() <= 160)
        && (signedOn == '' || recordDate(d.signedOn) && d.signedOn <= recordToday())
        && d.createdBy is string && d.createdBy.size() <= 254 && d.createdAt is timestamp
        && d.updatedBy == email() && d.updatedAt == request.time
        && recordIdPart(d.lastEventId) && d.fileName is string && d.fileName.size() <= 255
        && (d.fileId == '' && d.fileName == '' || recordIdPart(d.fileId) && d.fileName.size() > 0);
    }
    function recordEvent(id, d, prior) {
      let event = getAfter(/databases/$(database)/documents/correspondence/$(id)/events/$(d.lastEventId)).data;
      return event.actor == email() && event.at == request.time
        && event.from == prior && event.to == d.status
        && (!(d.status in ['issued','void']) || event.note.size() >= 10);
    }
    function recordFile(d, id, pdfOnly) {
      let file = getAfter(/databases/$(database)/documents/files/$(d.fileId)).data;
      return file.scopeType == 'correspondence' && file.scopeId == id
        && file.name == d.fileName && (!pdfOnly || file.type == 'application/pdf') && file.by == email();
    }
    function recordHasPdf(d) {
      return d.fileId != '' && getAfter(/databases/$(database)/documents/files/$(d.fileId)).data.type == 'application/pdf';
    }
    function recordRoute(d, old) {
      return d.assigneeEmail == old.assigneeEmail
        || (d.assigneeEmail == '' && d.status in ['registered','draft'])
        || recordActive(d.assigneeEmail);
    }
    function recordStep(old, d) {
      let transitions = old.direction == 'in'
        ? {'registered':['registered','assigned'], 'assigned':['assigned','processing'], 'processing':['processing','completed'], 'completed':['archived']}
        : {'draft':['draft','review'], 'review':['draft','approved'], 'approved':['signing'], 'signing':['signed','numbered'], 'signed':['numbered','issued'], 'numbered':['signed','issued','void'], 'issued':['archived']};
      return d.status in transitions.get(old.status, [])
        && (old.status != 'signed' || d.status != 'issued' || old.get('numbering',null) != null)
        && (old.status != 'numbered' || (d.status == 'void' || d.status == 'signed' && old.get('signedByName','') == '' || d.status == 'issued' && old.get('signedByName','') != ''));
    }
    function recordAdminEdit(old, d, id) {
      return recordAdmin() && recordRoute(d, old)
        && (d.direction != 'in' || (d.status == 'registered' ? d.assigneeEmail == ''
          : !(d.status in ['assigned','processing']) || recordActive(d.assigneeEmail)))
        && (old.status in ['registered','assigned','processing','draft']
          ? (d.fileId == old.fileId && d.fileName == old.fileName
            || old.fileId == '' && recordFile(d, id, true))
          : recordChanges().hasOnly(['status','updatedBy','updatedAt','lastEventId']));
    }
    function recordAssigneeEdit(old, d) {
      return recordMember() && old.assigneeEmail == email()
        && (old.status == 'assigned' && d.status == 'processing'
          || old.status == 'processing' && d.status == 'completed'
          || old.status == 'draft' && d.status == 'review'
          || old.status == 'approved' && d.status == 'signing')
        && recordChanges().hasOnly(['status','updatedBy','updatedAt','lastEventId']);
    }
    function recordCreateNumber(d, id) {
      return d.kind in ['letter','decision'] && d.registeredOn == recordToday()
        && (d.direction == 'in' ? recordAllocation(d, id)
          : d.serial == '' && d.get('numbering', null) == null && d.externalNumber == '' && d.documentOn == '' && d.get('signedByName','') == '' && d.get('signedOn','') == '');
    }
    function recordSignature(old, d, id) {
      return recordAdmin() && d.signedByName is string && d.signedByName.size() > 0 && d.signedByName.size() <= 160
        && recordDate(d.signedOn) && d.signedOn <= recordToday() && d.fileId != ''
        && (d.fileId == old.fileId && d.fileName == old.fileName ? recordHasPdf(d) : recordFile(d, id, true));
    }
    function recordUpdateNumber(old, d, id) {
      return old.direction == 'out' && old.status == 'signing' && d.status == 'numbered'
        ? old.get('numbering',null) == null && recordSignature(old,d,id) && recordAllocation(d,id)
          && recordChanges().hasOnly(['status','signedByName','signedOn','fileId','fileName','externalNumber','documentOn','numbering','updatedBy','updatedAt','lastEventId'])
        : old.direction == 'out' && old.status == 'signed' && d.status == 'numbered'
        ? (recordAdmin() || recordMember() && old.assigneeEmail == email())
          && old.get('numbering', null) == null && old.get('signedByName','') != '' && recordHasPdf(d) && recordAllocation(d, id)
          && recordChanges().hasOnly(['status','externalNumber','documentOn','numbering','updatedBy','updatedAt','lastEventId'])
        : d.status == 'signed' && old.status in ['signing','numbered']
          ? recordSignature(old,d,id) && recordChanges().hasOnly(['status','signedByName','signedOn','fileId','fileName','updatedBy','updatedAt','lastEventId'])
          : d.status == 'issued'
          ? recordAdmin() && old.get('signedByName','') != '' && old.get('numbering',null) != null
            && recordChanges().hasOnly(['status','fileId','fileName','updatedBy','updatedAt','lastEventId'])
            && (d.fileId == old.fileId && d.fileName == old.fileName ? recordHasPdf(d) : recordFile(d, id, true))
          : !recordChanges().hasAny(['numbering','kind','signedByName','signedOn'])
          && (d.direction == 'in' || !recordChanges().hasAny(['externalNumber','documentOn']))
          && (recordAdminEdit(old, d, id) || recordAssigneeEdit(old, d));
    }
    match /correspondence/{id} {
      allow read: if recordReadable(resource.data);
      allow create: if recordAdmin() && recordShape(request.resource.data, id)
        && request.resource.data.createdBy == email() && request.resource.data.createdAt == request.time
        && (request.resource.data.direction == 'in'
          ? (request.resource.data.assigneeEmail == '' && request.resource.data.status == 'registered'
            || request.resource.data.status == 'assigned' && recordActive(request.resource.data.assigneeEmail))
          : (request.resource.data.status == 'draft'
            && (request.resource.data.assigneeEmail == '' || recordActive(request.resource.data.assigneeEmail))))
        && recordCreateNumber(request.resource.data, id)
        && recordWatcherChange(request.resource.data.get('watchers',[]), [])
        && (request.resource.data.fileId == '' || recordFile(request.resource.data, id, false))
        && recordEvent(id, request.resource.data, '');
      allow update: if request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time
        && recordIdPart(request.resource.data.lastEventId)
        && (request.resource.data.status == 'numbered' || recordShape(request.resource.data, id))
        && !recordChanges().hasAny(['direction','year','serial','registeredOn','createdBy','createdAt','watchers'])
        && request.resource.data.lastEventId != resource.data.lastEventId
        && recordStep(resource.data, request.resource.data)
        && recordUpdateNumber(resource.data, request.resource.data, id)
        && recordEvent(id, request.resource.data, resource.data.status);
      allow update: if recordChanges().hasOnly(['watchers','updatedBy','updatedAt','lastEventId'])
        && recordChanges().hasAny(['watchers']) && recordAdmin()
        && recordWatcherChange(request.resource.data.watchers, resource.data.get('watchers',[]))
        && request.resource.data.updatedBy == email() && request.resource.data.updatedAt == request.time
        && recordIdPart(request.resource.data.lastEventId) && request.resource.data.lastEventId != resource.data.lastEventId
        && recordEvent(id, request.resource.data, resource.data.status);
      allow delete: if false;
      match /events/{eventId} {
        allow read: if recordReadable(get(/databases/$(database)/documents/correspondence/$(id)).data);
        allow create: if recordIdPart(eventId) && recordMember()
          && request.resource.data.keys().hasOnly(['actor','at','from','to','note'])
          && request.resource.data.actor == email() && request.resource.data.at == request.time
          && request.resource.data.from is string && request.resource.data.to is string
          && request.resource.data.note is string && request.resource.data.note.size() > 0
          && request.resource.data.note.size() <= 500
          && getAfter(/databases/$(database)/documents/correspondence/$(id)).data.lastEventId == eventId
          && getAfter(/databases/$(database)/documents/correspondence/$(id)).data.updatedAt == request.time
          && (!exists(/databases/$(database)/documents/correspondence/$(id))
            || get(/databases/$(database)/documents/correspondence/$(id)).data.lastEventId != eventId);
        allow update, delete: if false;
      }
    }

    match /notifications/{id} {
      function isRecipient() {
        return verified() && resource.data.to == email()
          && get(/databases/$(database)/documents/members/$(email())).data.get('enabled', true) != false;
      }
      function validProjectMention(data) {
        let project = get(/databases/$(database)/documents/projects/$(data.projectId)).data;
        let recipient = get(/databases/$(database)/documents/members/$(data.to)).data;
        let post = get(/databases/$(database)/documents/projects/$(data.projectId)/posts/$(data.postId)).data;
        return data.keys().hasOnly(['kind', 'projectId', 'postId', 'to', 'from', 'title', 'body',
            'link', 'createdAt', 'read', 'emailed'])
          && projectPart(data.projectId) && projectPart(data.postId) && projectPart(data.to)
          && projectDiscussionAccess(data.projectId) && recipient.get('enabled', true) != false
          && (recipient.get('role', '') == 'admin' || data.to == project.get('ownerEmail', '')
            || data.to in project.get('collaborators', []))
          && data.from == email() && post.createdBy == email() && data.to != email() && data.to in post.mentions
          && data.title == 'Bạn được nhắc trong dự án' && data.body == 'Mở mục Trao đổi & tài liệu để xem nội dung.'
          && data.link == '#du-an' && isoDate(data.createdAt) && data.read == false && data.emailed == false;
      }

      allow get, list: if isRecipient();
      allow create: if activeMember() && request.resource.data.kind == 'record'
        && recordNotification(request.resource.data, id);
      allow create: if activeMember() && request.resource.data.kind == 'projectMention'
        && validProjectMention(request.resource.data);
      allow create: if attendanceAdmin()
        && request.resource.data.keys().hasOnly(['to', 'from', 'title', 'body', 'link', 'createdAt', 'read', 'emailed'])
        && request.resource.data.to is string
        && exists(/databases/$(database)/documents/members/$(request.resource.data.to))
        && request.resource.data.from == email()
        && request.resource.data.title is string
        && request.resource.data.title.matches('^Công ngày [0-9]{2}/[0-9]{2}/[0-9]{4} đã được điều chỉnh$')
        && request.resource.data.body is string && request.resource.data.body.size() <= 1000
        && request.resource.data.link == '#cham-cong'
        && isoDate(request.resource.data.createdAt)
        && request.resource.data.read == false && request.resource.data.emailed == false;
      allow update: if isRecipient() && request.resource.data.read == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // KPI snapshots are written by the existing server-side monthly closing job.
    match /kpi/{id} {
      allow read: if activeMember() && (hasMemberGrant('kpiRead') || resource.data.email == email());
    }

    match /tasks/{id} {
      allow read: if attendanceAdmin();
      allow get, list: if activeMember() && resource.data.assigneeEmail == email();
      // The server sets assignedBy at creation. Client updates cannot change it.
      allow read: if member() && resource.data.assignedBy == email()
        && get(/databases/$(database)/documents/members/$(email())).data.get('enabled', true) != false;
      // A designated approver can read the task while its submission is pending.
      allow get, list: if activeMember() && resource.data.approverEmail == email()
        && resource.data.status == 'Chờ duyệt' && hasReviewGrant();
      allow update: if activeMember() && resource.data.assigneeEmail == email()
        && openStatus(resource.data.status) && openStatus(request.resource.data.status)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'progress', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == email()
        && isoDate(request.resource.data.updatedAt)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['progress'])
          || (resource.data.get('checklist', []).size() == 0
            && request.resource.data.progress is int
            && request.resource.data.progress >= 0 && request.resource.data.progress <= 100));
      allow update: if activeMember() && resource.data.status != 'Xong'
        && (resource.data.assigneeEmail == email() || resource.data.get('assignedBy', '') == email())
        && appendsComment();

      function hasReviewGrant() {
        let profile = get(/databases/$(database)/documents/members/$(email())).data;
        let grants = profile.get('grants', []);
        return profile.get('enabled', true) != false
          && (profile.get('role', '') == 'admin' || (grants is list && 'taskReview' in grants));
      }
    }
  }
}
