{
  "cli": {
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "pilot-ios": {
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_FIREBASE_MODE": "pilot"
      },
      "ios": {
        "autoIncrement": true
      }
    },
    "ios-simulator-demo": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "MARCHIX_IOS_SIMULATOR": "1",
        "EXPO_PUBLIC_FIREBASE_MODE": "emulator"
      },
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "pilot-ios": {}
  }
}
