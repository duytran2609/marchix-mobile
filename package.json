{
  "name": "marchix-mobile",
  "description": "Bản thử ứng dụng Quản lý Marchix",
  "private": true,
  "license": "0BSD",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "~58.0.23",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "firebase": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "~19.3.0",
    "firebase-tools": "15.35.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "emulator": "firebase emulators:start --only auth,firestore,functions --project demo-marchix-mobile",
    "emulator:lan": "firebase emulators:start --config firebase.lan.json --only auth,firestore,functions --project demo-marchix-mobile",
    "seed": "node scripts/seed.mjs",
    "test:rules": "node tests/rules.mjs",
    "test:workflow": "node tests/workflow.mjs",
    "test:preview": "playwright test",
    "test:local": "firebase emulators:exec --only auth,firestore,functions --project demo-marchix-mobile \"npm run seed && npm run test:rules && npm run test:workflow && npm run test:preview\""
  }
}
