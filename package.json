{
  "name": "marchix-mobile",
  "description": "Bản thử ứng dụng Quản lý Marchix",
  "private": true,
  "license": "0BSD",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "firebase": "^13.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-blob-util": "^1.1.1",
    "react-native-pdf": "^7.0.5",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "~0.21.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "emulator": "node tools/firebase-cli/node_modules/firebase-tools/lib/bin/firebase.js emulators:start --only auth,firestore,functions --project demo-marchix-mobile",
    "emulator:lan": "node tools/firebase-cli/node_modules/firebase-tools/lib/bin/firebase.js emulators:start --config firebase.lan.json --only auth,firestore,functions --project demo-marchix-mobile",
    "seed": "node scripts/seed.mjs",
    "test:rules": "node tests/rules.mjs",
    "test:workflow": "node tests/workflow.mjs",
    "test:preview": "playwright test",
    "test:local": "node tools/firebase-cli/node_modules/firebase-tools/lib/bin/firebase.js emulators:exec --only auth,firestore,functions --project demo-marchix-mobile \"npm run test:unit && npm run seed && npm run test:rules && npm run test:workflow && npm run test:preview\"",
    "test:unit": "node --test tests/*.test.cjs"
  }
}
